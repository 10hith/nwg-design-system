{
  "preset_id": "s-chart",
  "description": "Chart on the left with narrative bullet points on the right.",
  "slots": ["title", "kicker", "chart_data", "narrative_items"],
  "components": [
    { "type": "inline-chart",  "box": { "x": 0.72, "y": 1.3, "w": 6.7, "h": 5.2  }, "props": "${chart_data}" },
    { "type": "kicker-label",  "box": { "x": 8.0,  "y": 1.1, "w": 4.5, "h": 0.22 }, "props": { "text": "${kicker}" } },
    { "type": "title-block",   "box": { "x": 8.0,  "y": 1.4, "w": 4.5, "h": 1.5  }, "props": { "title": "${title}", "size": 25 } },
    { "type": "bullet-list",   "box": { "x": 8.05, "y": 3.2, "w": 4.5, "h": 3.4  }, "props": { "items": "${narrative_items}" } }
  ]
}
